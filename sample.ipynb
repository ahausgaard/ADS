   "cell_type": "code",
   "source": [
    "t = 11\n",
    "x = [4,5,8,9,11]\n",
    "\n",
    "def linear_search(arr, target):\n",
    "    t = 0\n",
    "    for i, entry in enumerate(arr):\n",
    "        if entry == target:\n",
    "            return i\n",
    "    return -1\n",
    "\n",
    "print(linear_search(x, t))"
